{
  "name": "celadon-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Celadon 青瓷母带插件的宣传站、使用说明与公开算法（静态站）",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/check-i18n.mjs && tsc --noEmit && vite build && node scripts/gen-sitemap.mjs && node scripts/gen-zh-html.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "i18next": "^26.4.2",
    "i18next-resources-to-backend": "^1.2.3",
    "ogl": "^1.0.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
