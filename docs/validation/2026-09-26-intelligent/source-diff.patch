+        Signal makeLowHighSignal (double sampleRate, double lowHz, double seconds)
+        {
+            auto signal = makeSilence (numChannels, (int) (sampleRate * seconds));
+            for (int i = 0; i < (int) signal[0].size(); ++i)
+            {
+                const auto t = i / sampleRate;
